---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "UX Designer portfolio of Oskar Lundkvist" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

  :root {
    --color-bg:       #F5F0E8;
    --color-hero-bg:  #FFFFFF;
    --color-card-bg:  #EDE7D9;
    --color-text:     #1A1A1A;
    --color-sec:      #5C5450;
    --color-violet:   #63238C;
    --color-lavender: #C6B4FB;
    --color-border:   #E0D9CE;

    --pill-ux:        #63238C;
    --pill-product:   #C4511E;
    --pill-service:   #2D7A4A;
    --pill-research:  #1B5EA6;

    --font-display:   'Fraunces', serif;
    --font-body:      'Plus Jakarta Sans', sans-serif;

    --content-w:      720px;
    --pad:            80px;
    --pad-m:          24px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-text);
    -webkit-font-smoothing: antialiased;
  }

  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
</style>
